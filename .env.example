# Optional public HTTPS origin for canonical URLs and the sitemap.
# Vercel's stable production domain is used automatically when available.
# Leave unset locally. Set the actual domain in production, then rebuild.
# SITE_URL=https://your-production-domain.example

# Reserved for the future server-backed deck and login milestone.
DATABASE_URL=postgresql://user:password@localhost:5432/spellbook
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_ORIGIN=http://localhost:3000
